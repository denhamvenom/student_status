{
  "name": "denham-venom-student-status",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:backend": "convex dev",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build",
    "cloudflare:check": "wrangler deploy --dry-run",
    "codegen": "convex codegen --typecheck disable",
    "dev:timeclock": "bun run --cwd apps/timeclock dev",
    "check:timeclock": "bun run --cwd apps/timeclock check",
    "build:timeclock": "bun run --cwd apps/timeclock build",
    "cloudflare:timeclock": "bun run --cwd apps/timeclock cloudflare:check"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@base-ui/react": "^1.9.0",
    "@convex-dev/aggregate": "^0.3.2",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "convex": "1.46.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "7",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@convex-dev/batch-worker": "0.3.5",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.61",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "6",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "workspaces": [
    "apps/*"
  ]
}
