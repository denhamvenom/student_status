# Public development deployment URL. Never put secrets in VITE_ variables.
VITE_CONVEX_URL=
# Set by Convex configuration. Must be dev: or local: for local work.
CONVEX_DEPLOYMENT=

# Parent email settings belong in Convex's server environment, not VITE_ variables.
# Keep disabled until the sender/domain and intended deployment are verified.
# PARENT_INVITE_EMAIL_ENABLED=true
# RESEND_API_KEY=<server-only sending key>
# PARENT_INVITE_EMAIL_FROM=Denham Venom Robotics <notifications@team8044.org>
# PARENT_INVITE_EMAIL_REPLY_TO=coach@team8044.org
# PARENT_INVITE_APP_ORIGIN=https://your-student-status-host

# Calendar writes are production-only; development must never write the real calendar.
# Server-only switch after an authorized release and editor sharing check:
# STUDENT_STATUS_CALENDAR_WRITE_ENABLED=true
